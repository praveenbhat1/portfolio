# Cloudflare Pages header rules.
# Rules are additive, so this first block sets only security headers and leaves
# Cache-Control to the path-specific blocks below.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Content-hashed by Vite — a change produces a new filename, so cache forever.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Font filenames are stable and the files never change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and video keep their filenames across deploys, so cap the cache at a
# day. Replacing character.png should not leave people on a stale copy for a year.
/assets/*
  Cache-Control: public, max-age=86400

# HTML must revalidate every time or a deploy never reaches anyone.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
